# Environment Configuration for Valchandson Jewellers
# SQLite local development (default)
DATABASE_URL="file:./dev.db"

# Or PostgreSQL for production (Supabase / Neon / AWS RDS):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres"

# Secret key used for signing Admin JWT authentication tokens
JWT_SECRET="valchandson-heirloom-secret-key-2026-luxury-atelier-protection"
ADMIN_SESSION_COOKIE="vj_admin_token"

# Optional Cloud Storage (Supabase Storage / S3 / Cloudinary)
# If left commented out, high-resolution photography is stored locally in public/uploads/
# NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
